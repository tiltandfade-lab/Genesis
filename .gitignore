# ── Genesis .gitignore ───────────────────────────────────────────────
# Philosophy: commit source + small essential data; ignore heavy binaries
# and large regenerable build artifacts.

# OS / editor cruft
.DS_Store
*.swp

# Node dependencies (jsdom etc. — installed in a scratch dir, never here)
node_modules/
# CI's scratch jsdom install (dev/jsdom-home/package.json + node_modules) — see
# .github/workflows/ci.yml. Never committed; a fresh checkout has neither.
dev/jsdom-home/

# Claude Code machine-local settings (per-machine permission allowlist etc.).
# A shared .claude/settings.json, if ever added, stays trackable.
.claude/settings.local.json
# launch.json carries a machine-absolute path (the preview tool needs it) — keep it local.
.claude/launch.json

# Large copyrighted source PDFs (scanned rulebooks — NEVER commit or push).
# The machine-readable rules live in Reference/SRD-Data/ (committed) instead.
*.pdf

# tables.json / tables.js ARE committed (tracked) so a fresh checkout always runs
# (the Oracle tab needs tables.js) and compile output stays diff-able/bisectable.
# They're still GENERATED — never hand-edit; regenerate with:
#   python3 "Engine/00. _System/compile-tables.py" --emit

# Pre-git manual backups — git history replaces these going forward.
# (Left on disk, just untracked.)
Archive/

# NOTE — these ARE committed (small, essential, low-churn), do not add here:
#   data/spells-slim.js     (generated by build/gen-spells-slim.py)
#   data/srd-creator.js     (hand-authored)
#   Reference/SRD-Data/**   (the DM's machine-readable rules layer)

# DM Bridge runtime mailbox (dev harness — not committed)
.dm/

# Isolated/extracted UI asset cutouts — bulky + regenerable from the magenta source sheets
# via ui-sketches/ivalice-style/assets-iso/{extract,slice-grid}.py. The source sheets + the
# scripts + the served subset in assets/icons/ ARE committed.
ui-sketches/ivalice-style/assets-iso/extracted/

# Creature sprite-sheet pipeline (docs/SPRITE-SHEETS.md) — same shape as the UI cutouts
# above: bulky binaries regenerable via the pipeline (gen-sprite-manifests.py writes the
# prompts, Adam runs them through ChatGPT, slice-sprites.py slices the result). The
# manifests/prompts (dev/sprite-manifests/*.txt, manifest.json) + both scripts ARE committed
# — they're the small deterministic source. The raw ChatGPT sheet PNGs and their sliced
# output are not.
dev/sprite-sheets/incoming/*.png
dev/sprite-manifests/review/
assets/sprites/*.png
dev/.playtest-stop

# session render outputs (regenerable, not committed)
dev/model-qa/battlemap-shots/
dev/model-qa/proof-sheets/

# Obsidian editor config (Adam's vault view state — never tracked)
.obsidian/
# STATE-HYGIENE-EVAL: scorecard artifacts are per-run outputs; baselines/budgets are committed truth
dev/state-eval/out/
