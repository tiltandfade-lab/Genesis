  "hardRejections": [
    {
      "code": "RANDOM_TILE_TERRAIN",
      "test": "Natural cells behave as unrelated per-tile slope events."
    },
    {
      "code": "DIAGONAL_ZIPPER",
      "test": "Arbitrary triangulation creates a visible zig-zag seam across a landform."
    },
    {
      "code": "SEDIMENTARY_RIDGE_REPEAT",
      "test": "Repeated parallel bands or scarps substitute for a coherent landform."
    },
    {
      "code": "GLOBAL_HEIGHT_CAP",
      "test": "Terrain or structure height is globally limited to one quantum, five feet, or two storeys."
    },
    {
      "code": "UNOWNED_TRAVERSABLE_HEIGHT",
      "test": "A traversable height change lacks a mechanics-owned connector."
    },
    {
      "code": "MATERIAL_INVENTS_AFFORDANCE",
      "test": "Paint, decal, context, or donor art implies an opening, route, cover, support, or interaction the geometry and mechanics do not own."
    },
    {
      "code": "UNCAUSED_JOIN",
      "test": "Constructed and natural masses meet without a sourced cut, rest, retain, bridge, pin, abut, or bury relation."
    },
    {
      "code": "FALSE_CONTEXT_AFFORDANCE",
      "test": "Context implies a reachable surface, exit, opening, hiding place, bridge, or route that does not exist."
    },
    {
      "code": "CAMERA_MUTATES_TRUTH",
      "test": "Quarter-turn rotation changes geometry, routes, object identity, state, or tactical fingerprints."
    },
    {
      "code": "UNCAUSED_WEAR",
      "test": "Wear or condition is evenly random or lacks an exposure, use, event, ecology, maintenance, or authority cause."
    },
    {
      "code": "PHYSICAL_STATE_INVENTS_OPERATION",
      "test": "Ruin, damage, repair, or age is used to infer occupancy, dormancy, ownership, or operating state without a source fact."
    },
    {
      "code": "SHARED_PARENT_MUTATION",
      "test": "An instance consequence changes a shared material parent or unrelated sibling instances."
    },
    {
      "code": "ACTIVE_FLOOR_OBSCURED",
      "test": "Depth of field, fog, grade, particles, bloom, or foreground framing hides active tactical truth."
    },
    {
      "code": "QUIET_GROUND_CONSUMED",
      "test": "Incidental dressing consumes protected quiet ground, route space, deployment, or an interaction apron."
    },
    {
      "code": "IDENTITY_OBLIGATION_DROPPED",
      "test": "A semantic identity reservation has neither a realized face treatment nor an explicit truthful fallback."
    }
  ],
  "softTargets": [
