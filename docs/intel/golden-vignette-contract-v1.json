  "enums": {
    "materializationDisposition": [
      "MATERIALIZE_NEW",
      "CONTINUE_EXISTING",
      "TRANSFORM_EXISTING",
      "DECORATE_LOCAL",
      "NARRATIVE_ONLY",
      "UNRESOLVED"
    ],
    "sourceTreatment": [
      "HARD_CANON",
      "ARRANGEABLE_CANON",
      "DERIVED_SUPPORT",
      "OPTIONAL_CONTEXT"
    ],
    "terrainStructureRelation": [
      "CUT_INTO",
      "RESTS_ON",
      "RETAINS",
      "BRIDGES",
      "PINS",
      "ABUTS",
      "BURIES"
    ],
    "terrainBreak": [
      "NATURAL_BREAK"
    ],
    "projectionKind": [
      "SCENE_TRAY",
      "TOWN_TRAY",
      "BATTLE_MAP",
      "TEXT",
      "DM_DIGEST"
    ],
    "resolutionDisposition": [
      "ADMITTED_ASSET",
      "ENGINE_RECIPE",
      "TRUTHFUL_PROXY",
      "OMITTED",
      "UNRESOLVED"
    ]
  },
  "invariants": [
    "golden ids never select runtime generator behavior",
    "natural terrain edges and gradients negotiate continuity unless a sourced break is intended",
    "height is budgeted rather than globally capped",
    "terrain and construction share one datum, support graph, route graph and reservation set",
    "combat and camera projections cannot change committed topology",
    "all semantic asset demands receive a resolution disposition",
    "all fallbacks and repairs are named and receipted"
  ]
}
